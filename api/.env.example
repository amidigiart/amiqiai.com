# amiQiAI Companion API — Environment Variables
# Copy to .env and fill in your keys

# Grok (xAI) — get key at https://console.x.ai/
GROK_API_KEY=xai-...
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini-fast

# DeepSeek — get key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Mock mode (set true to test without API keys)
AMIQIAI_MOCK=false

# CORS origins (comma-separated)
CORS_ORIGINS=https://amiqiai.com,http://localhost:8000
